1291:STM32_WPAN/App/app_ble.c **** 
1292:STM32_WPAN/App/app_ble.c ****     p_bd_addr = (const uint8_t *)a_BdAddrUdn;
1293:STM32_WPAN/App/app_ble.c ****   }
1294:STM32_WPAN/App/app_ble.c ****   else
1295:STM32_WPAN/App/app_ble.c ****   {
