1356:STM32_WPAN/App/app_ble.c **** 
1357:STM32_WPAN/App/app_ble.c ****     case APP_BLE_FAST_ADV:
1358:STM32_WPAN/App/app_ble.c ****       /* The 60 s fast-advertising timer will switch to low power advertising */
