1415:STM32_WPAN/App/app_ble.c ****                                CFG_TS_TICK_VAL);
1416:STM32_WPAN/App/app_ble.c ****     if (timeout_ticks == 0U)
1417:STM32_WPAN/App/app_ble.c ****     {
1418:STM32_WPAN/App/app_ble.c ****         timeout_ticks = 1U;
1419:STM32_WPAN/App/app_ble.c ****     }
1420:STM32_WPAN/App/app_ble.c **** 
