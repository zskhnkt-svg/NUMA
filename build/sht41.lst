  95:Core/Src/sht41.c ****   uint16_t raw_temperature = ((uint16_t)buffer[0] << 8) | buffer[1];
  96:Core/Src/sht41.c ****   uint16_t raw_humidity    = ((uint16_t)buffer[3] << 8) | buffer[4];
  97:Core/Src/sht41.c **** 
  98:Core/Src/sht41.c ****   /*
  99:Core/Src/sht41.c ****    * SHT41 conversion formulas from the datasheet.
 100:Core/Src/sht41.c ****    */
 101:Core/Src/sht41.c ****   data->temperature = -45.0f +
 102:Core/Src/sht41.c ****                       (175.0f * (float)raw_temperature / 65535.0f);
 103:Core/Src/sht41.c **** 
 104:Core/Src/sht41.c ****   data->humidity = -6.0f +
 105:Core/Src/sht41.c ****                    (125.0f * (float)raw_humidity / 65535.0f);
 106:Core/Src/sht41.c **** 
 107:Core/Src/sht41.c ****   /*
 108:Core/Src/sht41.c ****    * Physical RH range is 0...100 %. The raw conversion can produce a
 109:Core/Src/sht41.c ****    * slightly wider mathematical range at the edges.
 110:Core/Src/sht41.c ****    */
 111:Core/Src/sht41.c ****   if (data->humidity < 0.0f)
 112:Core/Src/sht41.c ****   {
 113:Core/Src/sht41.c ****     data->humidity = 0.0f;
 114:Core/Src/sht41.c ****   }
 115:Core/Src/sht41.c ****   else if (data->humidity > 100.0f)
 116:Core/Src/sht41.c ****   {
 117:Core/Src/sht41.c ****     data->humidity = 100.0f;
 118:Core/Src/sht41.c ****   }
 119:Core/Src/sht41.c **** 
 120:Core/Src/sht41.c ****   return HAL_OK;
 121:Core/Src/sht41.c **** }
